# Inbound: Cloudflare Email Routing (corra@jahanshasys.com) forwards to the dedicated Gmail below.
# Corra polls that Gmail over IMAP. Values below are fixed for Gmail; fill USER/PASSWORD.
CORRA_IMAP_HOST=imap.gmail.com
CORRA_IMAP_PORT=993
CORRA_IMAP_USER=            # the dedicated Gmail address, e.g. corra.jahanshasys@gmail.com
CORRA_IMAP_PASSWORD=        # Gmail App Password (16 chars, NOT the account password)
# Outbound: Gmail SMTP, sending "as" corra@jahanshasys.com (set up via Gmail "Send mail as").
CORRA_SMTP_HOST=smtp.gmail.com
CORRA_SMTP_PORT=587
CORRA_SMTP_USER=            # same dedicated Gmail address
CORRA_SMTP_PASSWORD=        # same Gmail App Password
CORRA_FROM_ADDRESS=corra@jahanshasys.com
CORRA_X_N8N_WEBHOOK=        # your veil-social/n8n X-post webhook (or leave blank to wire X later)
